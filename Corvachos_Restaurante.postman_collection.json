      "name": "11. Pruebas de Seguridad JWT (401 y 403 Sustentación)",
      "item": [
        {
          "name": "1. Sin Token -> GET /api/administradores (401 Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/administradores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores"]
            },
            "description": "Envía la petición sin header Authorization (No Auth). El backend responde 401 Unauthorized con MensajeDTO."
          }
        },
        {
          "name": "2. Sin Token -> POST /api/productos (401 Unauthorized)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Intento Sin Token\",\n  \"precio\": 10000,\n  \"descripcion\": \"Prueba\",\n  \"imagen\": \"https://via.placeholder.com/150\",\n  \"disponible\": true,\n  \"categoria\": { \"id\": 1 }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            },
            "description": "Aunque GET /api/productos es público, POST /api/productos exige rol ADMIN. Sin token responde 401 Unauthorized."
          }
        },
        {
          "name": "3. Rol Incorrecto -> GET /api/administradores (403 Forbidden con token de CLIENTE u OPERADOR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/administradores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores"]
            },
            "description": "Haz primero 'Login Cliente' o 'Login Operador' y luego ejecuta esta petición: como el token es válido pero el rol no es ADMIN, responde 403 Forbidden."
          }
        },
        {
          "name": "4. Cliente Ajeno -> GET /api/clientes/2 (403 Forbidden con token del Cliente 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "2"]
            },
            "description": "Haz primero 'Login Cliente' (que inicia sesión como el cliente 1: cedeno.danielc@javeriana.edu.co) y luego ejecuta esta petición para intentar ver el perfil del cliente 2: @PreAuthorize bloquea con 403 Forbidden."
          }
        }
      ]
    }
