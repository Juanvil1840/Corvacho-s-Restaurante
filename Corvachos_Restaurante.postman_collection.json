{
  "info": {
    "_postman_id": "corvachos-restaurante-sprint-jwt-collection",
    "name": "Corvacho's Restaurante - Backend API (JWT + Roles)",
    "description": "Colección completa con todas las peticiones REST del backend de Corvacho's Restaurante, configurada con autenticación JWT Bearer Token y pruebas por rol (ADMIN, OPERADOR, CLIENTE).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Administradores (/api/administradores)",
      "item": [
        {
          "name": "Login Administrador (Guarda Token ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('token', data.token);",
                  "        console.log('Token ADMIN guardado en {{token}}');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin1\",\n  \"contrasena\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/administradores/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores", "login"]
            },
            "description": "Autentica a un administrador (público). Devuelve AuthResponseDTO con token JWT, rol ADMIN y AdministradorDTO, y guarda automáticamente el token en la variable {{token}}."
          }
        },
        {
          "name": "Listar Administradores (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/administradores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores"]
            },
            "description": "Requiere rol ADMIN. Retorna lista de AdministradorDTO (id_administrador, nombre, usuario) sin exponer contraseñas ni UserEntity."
          }
        },
        {
          "name": "Buscar Administrador por ID (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/administradores/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores", "1"]
            },
            "description": "Requiere rol ADMIN. Retorna AdministradorDTO."
          }
        },
        {
          "name": "Crear Administrador (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Administrador\",\n  \"usuario\": \"admin_nuevo\",\n  \"contrasena\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/administradores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores"]
            },
            "description": "Requiere rol ADMIN. Crea el Administrador y su UserEntity con rol ADMIN y contraseña encriptada."
          }
        },
        {
          "name": "Actualizar Administrador (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Daniel Cedeño Actualizado\",\n  \"usuario\": \"admin1\",\n  \"contrasena\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/administradores/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores", "1"]
            },
            "description": "Requiere rol ADMIN. Actualiza un administrador existente."
          }
        },
        {
          "name": "Eliminar Administrador (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/administradores/5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "administradores", "5"]
            },
            "description": "Requiere rol ADMIN. Elimina el administrador y su UserEntity asociado."
          }
        }
      ]
    },
